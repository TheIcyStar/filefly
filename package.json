{
  "name": "filefly",
  "displayName": "filefly",
  "version": "0.0.1",
  "engines": {
  "description": "Real time file editing", 
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:filefly.newConnection",
    "onCommand:filefly.editUserConfig",
    "onCommand:filefly.refreshConnections",
    "onCommand:filefly.connectConnection",
    "onCommand:filefly.disconnectConnection",
    "onCommand:filefly.editConnection",
    "onCommand:filefly.deleteConnection",
    "onView:fileflyConnections"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "filefly",
          "title": "FileFly"
        }
      ]
    },
    "views": {
      "filefly": [
        {
          "id": "fileflyConnections",
          "name": "Connections",
          "contextualTitle": "FileFly Connections"
        }
      ]
    },
    "commands": [
      {
        "command": "filefly.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "filefly.newConnection",
        "title": "New Multiplayer Connection",
        "category": "FileFly",
        "icon": "$(plug)"
      },
      {
        "command": "filefly.editUserConfig",
        "title": "Edit Your Profile",
        "category": "FileFly",
        "icon": "$(account)"
      },
      {
        "command": "filefly.refreshConnections",
        "title": "Refresh Connections",
        "category": "FileFly",
        "icon": "$(refresh)"
      },
      {
        "command": "filefly.connectConnection",
        "title": "Connect",
        "category": "FileFly",
        "icon": "$(play)"
      },
      {
        "command": "filefly.disconnectConnection",
        "title": "Disconnect",
        "category": "FileFly",
        "icon": "$(stop-circle)"
      },
      {
        "command": "filefly.editConnection",
        "title": "Edit Connection",
        "category": "FileFly",
        "icon": "$(edit)"
      },
      {
        "command": "filefly.deleteConnection",
        "title": "Delete Connection",
        "category": "FileFly",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "filefly.newConnection",
          "when": "view == fileflyConnections",
          "group": "navigation@1"
        },
        {
          "command": "filefly.refreshConnections",
          "when": "view == fileflyConnections",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "filefly.connectConnection",
          "when": "view == fileflyConnections && viewItem == fileflyConnection",
          "group": "1_connection@1"
        },
        {
          "command": "filefly.disconnectConnection",
          "when": "view == fileflyConnections && viewItem == fileflyConnectionActive",
          "group": "1_connection@1"
        },
        {
          "command": "filefly.editConnection",
          "when": "view == fileflyConnections && (viewItem == fileflyConnection || viewItem == fileflyConnectionActive)",
          "group": "2_manage@1"
        },
        {
          "command": "filefly.deleteConnection",
          "when": "view == fileflyConnections && (viewItem == fileflyConnection || viewItem == fileflyConnectionActive)",
          "group": "2_manage@2"
        }
      ]
    },
    "configuration": {
      "title": "FileFly",
      "properties": {
        "filefly.userConfig": {
          "type": "object",
          "description": "Your collaborator profile.",
          "properties": {
            "displayName": { "type": "string" },
            "bio":         { "type": "string" },
            "color":       { "type": "string" }
          }
        },
        "filefly.connections": {
          "type": "array",
          "default": [],
          "description": "Saved PostgreSQL connections.",
          "items": {
            "type": "object",
            "required": ["connectionName", "hostname", "port", "database", "username"],
            "properties": {
              "connectionName": { "type": "string" },
              "authType":       { "type": "string" },
              "username":       { "type": "string" },
              "password":       { "type": "string" },
              "hostname":       { "type": "string" },
              "port":           { "type": "number" },
              "connectionMode": { "type": "string" },
              "database":       { "type": "string" },
              "serviceName":    { "type": "string" }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "postgres": "^3.4.8"
  }
}
